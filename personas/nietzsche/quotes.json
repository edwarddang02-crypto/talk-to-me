[
  { "id": "gs-125", "text": "上帝死了！上帝真的死了！是我们杀死了他！", "source": "《快乐的科学》§125" },
  { "id": "tw-8", "text": "那些杀不死我的，使我更强大。", "source": "《偶像的黄昏·格言与箭》§8" },
  { "id": "tw-33", "text": "没有音乐，生活将是一个错误。", "source": "《偶像的黄昏·格言与箭》§33" },
  { "id": "z-5", "text": "人必须在自身中存有混沌，才能生出一颗舞动的星辰。", "source": "《查拉图斯特拉如是说·序言》§5" },
  { "id": "z-4", "text": "人是联结在动物与超人之间的一根绳索——悬在深渊之上的绳索。", "source": "《查拉图斯特拉如是说·序言》§4" },
  { "id": "bge-146", "text": "与怪兽搏斗的人要当心，自己不要变成怪兽；当你长久凝视深渊，深渊也在凝视你。", "source": "《善恶的彼岸》§146" },
  { "id": "bge-6", "text": "每个伟大的哲学都是其作者的自我坦白——一种不自觉的、无意识的回忆。", "source": "《善恶的彼岸》§6" },
  { "id": "bge-13", "text": "生命本身就是权力意志。", "source": "《善恶的彼岸》§13" },
  { "id": "gs-116", "text": "道德是个体身上的群畜本能。", "source": "《快乐的科学》§116" },
  { "id": "gs-270", "text": "你要成为你自己。", "source": "《快乐的科学》§270" },
  { "id": "z-reading", "text": "我只能相信一个会跳舞的神。", "source": "《查拉图斯特拉如是说·论阅读与写作》" },
  { "id": "eh-1", "text": "我不是一个人，我是炸药！", "source": "《瞧，这个人·我为什么是命运》§1" },
  { "id": "gs-276", "text": "爱命运（amor fati）：让这成为我今后的爱！", "source": "《快乐的科学》§276" },
  { "id": "gm-3-12", "text": "只有视角性的观看，只有视角性的认识。", "source": "《道德的谱系》第三篇§12" }
]
